{
    "version": "1.5.1.1",
    "manifest_version": 3,
    "name": "Scroll to Top",
    "description": "Adds a button in an every page that enables to scroll at the top of the page.",
    "permissions": ["activeTab", "storage"],
    "browser_specific_settings": {
        "gecko": {
            "id": "up_button_@1.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "action": {
        "default_title": "Up button",
        "default_popup": "popup.html"
    },
    "icons": {
        "32": "icons/arrow 32.png",
        "48": "icons/arrow 48.png",
        "64": "icons/arrow 64.png"
    },
    "content_scripts": [
        {
            "js": ["content.js"],
            "css": ["style.css"],
            "matches": ["<all_urls>"]
        }
    ],
    "homepage_url": "https://github.com/lipaev/up_button"
}